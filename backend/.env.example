# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public HTTPS URL forwarding to the backend on port 5000 (e.g. via ngrok)
PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev
JWT_SECRET=your_jwt_secret_key_here

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/iva_cc_db

# Redis (BullMQ queues) - if Redis is not running, falls back to built-in local queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Twilio Telephony Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CALLER_ID=+447479274450
TWILIO_SIP_DOMAIN=
DEFAULT_TRANSFER_NUMBER=+44xxxxxxxx

# OpenAI Voice & Realtime API Configuration
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_AUDIO_FORMAT=pcmu
OPENAI_REALTIME_AUDIO_SAMPLE_RATE=8000
VOICE_AI_ENABLED=true
